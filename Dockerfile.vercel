# Vercel container entrypoint.
#
# vercel.json pins "framework": "container", so Vercel builds this image and
# routes all traffic to it — no `services` / `rewrites` block needed (those are
# only for multi-service projects) and no dashboard framework change required.
# Pinning the preset also stops Vercel from applying a Node framework build to
# the API handlers, which would try to compile them as Vercel Functions and
# fail on their `import "hatchable"`. The handlers live in server/api/ (not a
# repo-root api/ dir) so Vercel's function detection doesn't count the 22
# files against the Hobby plan's 12-function deployment limit — the container
# serves every /api/* route itself.
#
# The app has zero runtime npm dependencies — everything is Node builtins.
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=80
COPY . .

# Deliberately runs as root: Vercel's container router targets $PORT (default
# 80), and a non-root process cannot bind a privileged port — it fails with
# EACCES and the function dies on boot. Vercel's own container examples run as
# root too. The image is only ever run inside Vercel's isolated function sandbox.
# Running as root also lets the app create its .data/ runtime store in /app.
EXPOSE 80
CMD ["node", "server/index.js"]
